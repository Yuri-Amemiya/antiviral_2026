# One row per household member exposed to an index case. Required columns:
#
#   household_id
#       Household identifier.
#   index_case_drug
#       Antiviral given to the index case:
#       "1" = molnupiravir, "2" = nirmatrelvir/ritonavir, "3" = ensitrelvir,
#       "6" = no antiviral (comparison group).
#   treated
#       1 if the index case received an antiviral, 0 otherwise.
#   x_for_index
#       Time (days) from illness onset of the index case to antiviral
#       administration. Used only when treated = 1.
#   index_case_vaccine_type
#       Type of COVID-19 vaccine last received by the index case before onset:
#       1-2 = Pfizer/Moderna monovalent XBB.1.5,
#       3-4 = Pfizer/Moderna bivalent (ancestral + BA.1 or BA.4/BA.5),
#       5-6 = Pfizer/Moderna monovalent ancestral,
#       7   = other vaccines,
#       any other value = unvaccinated.
#   index_case_vaccine_doses
#       Number of vaccine doses received by the index case before onset
#       (v_i in Eq. 2-3; 0 = unvaccinated).
#   index_case_onset_vaccine_interval
#       Days from the last vaccination to illness onset of the index case
#       (1000 = no vaccination record).
#   index_case_naturalinfection_onset_interval
#       Days from previous SARS-CoV-2 infection to illness onset of the index
#       case (1000 = no previous infection).
#   occupant_infected
#       1 if the household member became a secondary case, 0 otherwise.
#   occupant_tau
#       Generation time (days) from the index case to the secondary case
#       (secondary cases only; NA otherwise).
#   occupant_vtype
#       Vaccine type of the household member (k_j):
#       1 = Pfizer/Moderna monovalent XBB.1.5,
#       2 = Pfizer/Moderna bivalent (ancestral + BA.1 or BA.4/BA.5),
#       3 = Pfizer/Moderna monovalent ancestral,
#       4 = other vaccines,
#       5 = unvaccinated (reference).
data_file <- "occupant_df.rds"

incubation_period <- 2.6                 # infection to illness onset (days), fixed
ve_infectiousness <- c(0.124, 0.232, 0.328)
no_record_code <- 1000                   # "no vaccination" / "no previous infection"

# beta_{v_i} / c = 1 - (0.124 delta_{v_i,1} + 0.232 delta_{v_i,2} + 0.328 delta_{v_i,3})
# The reduction is applied to index cases with a vaccination record.
index_vaccine_factor <- function(doses, vacc_interval, nat_interval, vtype) {
  stopifnot(!anyNA(doses), !anyNA(vacc_interval), !anyNA(nat_interval))
  n  <- pmin(as.integer(doses), 3L)                 # 3 = three or more doses
  ve <- ifelse(n >= 1L, ve_infectiousness[pmax(n, 1L)], 0)
  vaccinated  <- vacc_interval != no_record_code
  prev_infect <- nat_interval  != no_record_code
  apply_ve    <- vaccinated & (prev_infect | vtype != 5)
  as.numeric(ifelse(apply_ve, 1 - ve, 1))
}

